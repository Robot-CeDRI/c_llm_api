/* Style for the Input widget */
#txt-doc {
    padding-top: 1;
    padding-left: 1;
    border: none;
    margin-top: 1;
}

/* Style for buttons */
Button {
    background: #5E81AC;   /* Button background color */
    color: #ECEFF4;        /* Button text color */
    margin: 0 1;  /* Horizontal margin */

}

Grid {
    grid-size: 4 1;
    grid-columns: 25% 25% 25% 25%;
    width: 100%;
}

Button {
    width: 100%;
    margin-top: 1;
}

/* Style for buttons on hover */
Button:hover {
    background: #81A1C1;   /* Lighter button color on hover */
}

/* Style for the quit button */
#btn-exit {
    background: #BF616A;   /* Exit button color */
}

/* Style for the quit button on hover */
#btn-exit:hover {
    background: #81A1C1;   /* Same color on hover, can be modified */
}

DataTable {
    margin-top: 1;
    width: 100%;
}

Container {
    width: 100%;
    height: 10;
}

Label {
    align: center top;
}